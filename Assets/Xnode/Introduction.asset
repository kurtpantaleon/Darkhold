      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Cassiel\u2019s voice is final. \u201CPrepare yourselves. Your descent
    into Nyxholm begins at first light.\u201D"
  exit: 
  backgroundImage: {fileID: -3480606835806699306, guid: 3b4f47255a73a6543961ced68ee7687f, type: 3}
  backgroundMusic: 0
