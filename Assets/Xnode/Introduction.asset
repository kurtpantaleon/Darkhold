      _dynamic: 0
  entry: 
  dialogText: "All of you were doing your own thing and a sudden darkness. A brief
    sensation of weightlessness. The sound of crackling energy fills your ears. Then\u2014light
    erupts around you. Your feet touch solid ground as a circle of radiant glyphs
    pulses beneath you. The air is thick with arcane power, and the scent of ozone
    lingers."
  exit: 
  backgroundImage: {fileID: -855298285791758126, guid: 3e2dc66b28cc209429eb28319144448e, type: 3}
  backgroundMusic: 0
