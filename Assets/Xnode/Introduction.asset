        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Closing the Scene \nCassiel folds his arms, his violet eyes filled
    with something between worry and hope. \nCassiel: \u201CYou have the opportunity
    to do what none before you could. If there is any chance of stopping this, it
    lies within you.\u201D \nMalrik turns, his obsidian armor clinking as he does.
    \nMalrik: \u201CGet ready. We leave at first light.\u201D"
  exit: 
  backgroundImage: {fileID: 8288426215254106694, guid: 002d7eeb1192c6644822038650e6a199, type: 3}
  backgroundMusic: 0
