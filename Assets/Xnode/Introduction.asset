      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: " A shimmer forms into a message:\n\n\u201CHe was not meant to wake.\u201D\n"
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
