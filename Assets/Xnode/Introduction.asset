  entry: 
  dialogText: 'You fought valiantly and defeated the Phantasmal Guardians. Their
    forms dissipate, leaving behind:

    Echo-Touched Armor (Uncommon, Light Armor)

    Phantom
    Blade (Rare, One-Handed Weapon)

    Nyxholm Remnant (Rare, 1 per party)'
  exit: 
  backgroundImage: {fileID: 6631041493552626805, guid: 86b00e5e8abfda440adb1afa5ddccba5, type: 3}
  backgroundMusic: 0
