        node: {fileID: 104915439952916031}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "\nThe World Threads pulse brighter, but their glow is uneven, flickering
    as if something is feeding on them. The walls shimmer with echoes of the past,
    faint images of long-lost figures flickering in and out of existence.\nAhead,
    a massive doorway stands sealed, its surface engraved with layered arcane glyphs\u2014one
    half glowing with golden light, the other pulsing with shadow.\n"
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
--- !u!114 &1605069929194974493
MonoBehaviour:
  m_ObjectHideFlags: 0
