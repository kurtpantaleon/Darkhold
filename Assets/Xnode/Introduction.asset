    - _fieldName: exit
      _node: {fileID: 5384673542416476721}
      _typeQualifiedName: System.String, mscorlib, Version=4.0.0.0, Culture=neutral,
        PublicKeyToken=b77a5c561934e089
      connections:
      - fieldName: entry
        node: {fileID: -3239347109268641000}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "From the edge of the summoning platform, two figures approach. The
    first is Archmage Cassiel Vaelthorne... His violet eyes glow with arcane wisdom,
    yet his expression is grim. Beside him stands High Inquisitor Dain Malrik...
    his arms crossed in quiet scrutiny. Cassiel gestures, and the magic of the summoning
    circle fades. His voice is calm but urgent: \u201CYou stand here because you
    are among the most capable wielders of magic and scholars of the arcane.\u201D"
  exit: 
  backgroundImage: {fileID: 8517870006439156754, guid: ae4b27acb838fa747b5099323601e381, type: 3}
  backgroundMusic: 1
--- !u!114 &5499969748082161995
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3cc94c254eb490047b4acc6529ac6365, type: 3}
  m_Name: Simple Dialog V4
  m_EditorClassIdentifier: 
  graph: {fileID: 11400000}
  position: {x: 40, y: -1288}
  ports:
    keys:
    - entry
    - exit
    values:
    - _fieldName: entry
      _node: {fileID: 5499969748082161995}
      _typeQualifiedName: System.String, mscorlib, Version=4.0.0.0, Culture=neutral,
        PublicKeyToken=b77a5c561934e089
      connections:
      - fieldName: exit
        node: {fileID: 3604846868462848699}
        reroutePoints: []
      _direction: 0
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
    - _fieldName: exit
      _node: {fileID: 5499969748082161995}
      _typeQualifiedName: System.String, mscorlib, Version=4.0.0.0, Culture=neutral,
        PublicKeyToken=b77a5c561934e089
      connections:
      - fieldName: entry
        node: {fileID: -666053629745349635}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Nyxholm \nCassiel: \u201CNyxholm was once part of Icarus\u2014a city
    beneath a city... But something\u2026 went wrong. It was sealed away, erased
    from history.\u201D \nMalrik snorts. \u201CThat means whatever was locked down
    there is still there.\u201D \nAether Nexus \nCassiel: \u201CThe Nexus binds the
    ley lines that keep Icarus aloft... If we do not stop it\u2026\u201D \nThe ground
    shudders slightly beneath you. \nMalrik: \u201CWe fall.\u201D \nDanger in Nyxholm
    \nCassiel: \u201CArcane remnants. Wards and constructs meant to guard secrets.
    Perhaps even\u2026 something worse.\u201D \nMalrik\u2019s voice is low and grim.
    \u201CWhatever was left down there has had centuries to fester. Expect the worst.\u201D"
  exit: 
  backgroundImage: {fileID: -4987914821148657504, guid: b0bfe5ab8a50d4a499b6739426326c87, type: 3}
  backgroundMusic: 0
--- !u!114 &5520511667802121778
