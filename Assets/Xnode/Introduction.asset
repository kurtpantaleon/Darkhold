        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "He turns his piercing gaze upon you. \u201CSomething down there is
    breaking the Nexus. And if it is not stopped, Icarus will be no more.\u201D A
    pause. Then, his voice lowers, questioning. \u201CBut before we send you into
    the unknown\u2026 who are you?\u201D"
  exit: 
  backgroundImage: {fileID: 4130640169021434097, guid: 9867881041a12c64eab683991d80ad52, type: 3}
  backgroundMusic: 0
