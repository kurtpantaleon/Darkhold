      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "\u201CWise\u2026 or cowardly? Time will tell. But the Watcher never
    forgets.                           \u201DYou step back. The Chronicle dims.\n"
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
