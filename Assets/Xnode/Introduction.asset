      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Cassiel waves his hand, conjuring an illusion of Icarus above his
    palm. The ley lines running through the city flicker like dying embers. Beneath
    the floating island, something dark stirs within its foundation. \u201COur divinations
    have traced the disturbance to the Forgotten Ruins beneath Icarus\u2014Nyxholm,
    a place abandoned long ago, erased from history.\u201D"
  exit: 
  backgroundImage: {fileID: -4178046375966092550, guid: d38e78b5b10d58341b1d701f8a87cff3, type: 3}
  backgroundMusic: 0
