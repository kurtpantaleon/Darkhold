        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: 'With the corrupted Sentinels defeated, the ruins of Nyxholm stand
    eerily quiet. The air hums with arcane tension, and the World Threads flicker
    weakly, like dying embers.

    The path ahead splits in two:

    (choose a
    path)

'
  exit: 
  backgroundImage: {fileID: -4987914821148657504, guid: b0bfe5ab8a50d4a499b6739426326c87, type: 3}
  backgroundMusic: 0
