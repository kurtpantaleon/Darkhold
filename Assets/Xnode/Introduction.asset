      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: ' The voice is a decaying spell, echoing endlessly.'
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
