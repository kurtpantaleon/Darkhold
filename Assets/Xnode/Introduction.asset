      _dynamic: 0
  entry: 
  dialogText: "In their final moments, you reached out to the Guardians, allowing
    them to find peace. They leave behind a final message\u2014a vision of Nyxholm\u2019s
    fall. You receive:\nWatcher\u2019s Blessing (Rare, Consumable)\nThe Chronicle
    of Icarus records their last words, providing an advantage in dealing with the
    Watcher or the Nexus.\n"
  exit: 
  backgroundImage: {fileID: -6642546021502082536, guid: 8808a38985160414f929173d0f83b910, type: 3}
  backgroundMusic: 0
