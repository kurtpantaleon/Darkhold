  entry: 11
  dialogText: "The Chronicles reveals a message might be useful\n\n\u201CThe beginning
    is marked by the one that faces the dawn.\u201D\n\u201CThe second follows the
    mark of endings, shadowed by the dusk.\u201D\n\u201CThe last bears the path of
    balance, standing between extremes.\u201D"
  exit: 
  backgroundImage: {fileID: 2508076209106177942, guid: 97079a5ae2fd9c745a319d0277c5f1d0, type: 3}
  backgroundMusic: 0
