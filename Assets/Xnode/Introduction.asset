      connections:
      - fieldName: entry
        node: {fileID: -4508034588086915573}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "He turns, his hand sweeping toward the city beyond. \u201CIcarus is
    dying. The Aether Nexus\u2014the artifact that holds this city aloft\u2014is
    failing.\u201D As if to confirm his words, the ground beneath you trembles slightly,
    and distant magical lanterns flicker erratically."
  exit: 
  backgroundImage: {fileID: -6470460504253458178, guid: 9e98026808c98dc4c9a4e92210e4780b, type: 3}
  backgroundMusic: 0
