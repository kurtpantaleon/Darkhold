  entry: 
  dialogText: "Chronicle of Icarus:\n\u201CThis is the nexus of what remains. Beyond
    here, the locks are failing. The gate may open soon.\u201D\n"
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
