      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: ' A floating pedestal holds strange, rune-infused relics. Light dances
    around you.'
  exit: 
  backgroundImage: {fileID: 0}
  backgroundMusic: 0
