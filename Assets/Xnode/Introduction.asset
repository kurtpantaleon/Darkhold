      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Cassiel: \u201CThey will have their chance to prove themselves, Dain.
    First, they must see what awaits them.\u201D \nHe gestures, and the illusion
    above his palm shifts\u2014now showing twisted caverns deep beneath Icarus...
    A tense silence falls."
  exit: 
  backgroundImage: {fileID: -5099292496197868168, guid: 6c8790e4ad0a3114ea40a24445e95c46, type: 3}
  backgroundMusic: 0
