  entry: 
  dialogText: "Reward: The players gain the Sealing Stone.\n\nYou purge the shadow
    runes, locking the Watcher away permanently. The Watcher screams, but remains
    trapped. As the chamber settles, something beyond the sealed door stirs\u2014something
    the Watcher was meant to stop.\n"
  exit: 
  backgroundImage: {fileID: 8801322515442651880, guid: 2e69148ccdad7844eaff7adca4856127, type: 3}
  backgroundMusic: 0
