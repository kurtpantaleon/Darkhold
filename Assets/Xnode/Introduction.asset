      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Before you move forward, the Chronicle of Icarus vibrates again, flipping
    to a new page. The faded text shifts, revealing a passage lost to time\u2014"
  exit: 
  backgroundImage: {fileID: -4987914821148657504, guid: b0bfe5ab8a50d4a499b6739426326c87, type: 3}
  backgroundMusic: 0
