      _typeQualifiedName: System.String, mscorlib, Version=4.0.0.0, Culture=neutral,
        PublicKeyToken=b77a5c561934e089
      connections: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  a: 'Arcana (DC 14): Understand the magic causing the problem and try to stabilize
    the runes.'
  b: 'Occult Investigation (DC 12): Find the damaged runes and figure out how to
    fix them. '
  c: 'Aetherics (DC 13): Stay balanced as the platform shakes violently. '
  d: 
  dialogText: "The magic runes keeping the platform stable are failing. If you don\u2019t
    act now, the platform will crash into the ruins below."
  dialogImage: {fileID: 1270987618666691537, guid: d4edac80457ac0a49a8db7f478d3f26c, type: 3}
  backgroundMusic: 0
