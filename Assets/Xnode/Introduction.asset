        node: {fileID: 5499969748082161995}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: "Nyxholm \nCassiel: \u201CNyxholm was once part of Icarus\u2014a city
    beneath a city... But something\u2026 went wrong. It was sealed away, erased
    from history.\u201D \nMalrik sorts. \u201CThat means whatever was locked down
    there is still there.\u201D \nAether Nexus \nCassiel: \u201CThe Nexus binds the
    ley lines that keep Icarus aloft... If we do not stop it\u2026\u201D \nThe ground
    shudders slightly beneath you. \nMalrik: \u201CWe fall.\u201D \nDanger in Nyxholm
    \nCassiel: \u201CArcane remnants. Wards and constructs meant to guard secrets.
    Perhaps even\u2026 something worse.\u201D \nMalrik\u2019s voice is low and grim.
    \u201CWhatever was left down there has had centuries to fester. Expect the worst.\u201D"
  exit: 
  backgroundImage: {fileID: 4130640169021434097, guid: 9867881041a12c64eab683991d80ad52, type: 3}
  backgroundMusic: 0
