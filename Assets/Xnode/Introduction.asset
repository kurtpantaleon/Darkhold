        node: {fileID: -1795220080086546366}
        reroutePoints: []
      _direction: 1
      _connectionType: 0
      _typeConstraint: 0
      _dynamic: 0
  entry: 
  dialogText: 'With the corrupted Sentinels defeated, the ruins of Nyxholm fall into
    an eerie silence. The air hums with arcane tension, the World Threads flickering
    like dying embers. Before you, the path splits in two.


    The Chronicle of
    Icarus vibrates again in your satchel. It flips open, revealing a faded page,
    the ink shifting to form lost words:'
  exit: 
  backgroundImage: {fileID: -4987914821148657504, guid: b0bfe5ab8a50d4a499b6739426326c87, type: 3}
  backgroundMusic: 0
